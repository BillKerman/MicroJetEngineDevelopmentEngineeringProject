void sendJson(String l_type, String l_value) {
  String jsonString = "";
  StaticJsonDocument<200> doc;
  JsonObject object = doc.to<JsonObject>();
  object["type"] = l_type;
  object["value"] = l_value;
  serializeJson(doc, jsonString);
  webSocket.broadcastTXT(jsonString);
}

// *** NEW FUNCTION: Smooth ESC speed transition ***
void setCompressorSpeedSmooth(int targetPulse) {
  int step = (currentCompressorPulse < targetPulse) ? 1 : -1;
  
  while (currentCompressorPulse != targetPulse) {
    currentCompressorPulse += step;
    compressorESC.writeMicroseconds(currentCompressorPulse);
    delay(5); // 5ms per step for smooth acceleration
  }
  
  Serial.printf("Compressor ESC pulse width: %d µs\n", currentCompressorPulse);
}

void updateOutputs() {
  // 1. Compressor Motor (ESC-controlled BLDC)
  if (compressor_on && compressor_speed > 0) {
    int targetPulse = map(compressor_speed, 0, 100, 1000, 2000);
    
    Serial.printf("Compressor: Speed=%d%%, Target Pulse=%d µs\n", 
                  compressor_speed, targetPulse);
    
    // Smooth transition to target speed
    setCompressorSpeedSmooth(targetPulse);
    
  } else {
    // Stop motor smoothly
    if (currentCompressorPulse > 1000) {
      Serial.println("Stopping compressor motor...");
      setCompressorSpeedSmooth(1000);
    }
    currentCompressorPulse = 1000;
    compressorESC.writeMicroseconds(1000);
  }

  // 2. Spark Plug - PULSING LOGIC (Active-LOW Relay with Open-Drain Logic)
  if (spark_on) {
    unsigned long currentTime = millis();
    
    // Check if 1.5 seconds have passed since last pulse
    if (currentTime - lastSparkTime >= SPARK_PULSE_INTERVAL) {
      sparkPulseState = !sparkPulseState; // Toggle pulse state
      lastSparkTime = currentTime;
      
      if (sparkPulseState) {
        // Turn ON: Pull pin to Ground (relay activates)
        pinMode(SPARK_PIN, OUTPUT);
        digitalWrite(SPARK_PIN, LOW);
        Serial.println("Spark: PULSE ON (Grounding pin)");
      } else {
        // Turn OFF: Float the pin (relay deactivates via pull-up resistor)
        pinMode(SPARK_PIN, INPUT);
        Serial.println("Spark: PULSE OFF (Floating pin)");
      }
    }
  } else {
    // Spark is disabled - ensure it's OFF
    pinMode(SPARK_PIN, INPUT);
    sparkPulseState = false;
    lastSparkTime = millis(); // Reset timer for next enable
  }

  // 3. Test LED (Digital)
  digitalWrite(BUILTIN_LED, builtin_led_on ? HIGH : LOW);

  // 4. Fuel Pump (PWM + L298N Direction)
  if (fuelpump_on && fuelpump_speed > 0) {
    digitalWrite(FUELPUMP_IN1, HIGH);
    digitalWrite(FUELPUMP_IN2, LOW);
    
    int dutyCycle = map(fuelpump_speed, 0, 100, MIN_DUTY_CYCLE, 255);
    analogWrite(FUELPUMP_ENA, dutyCycle);
    
    Serial.printf("Fuel Pump: Speed=%d%%, PWM Duty=%d\n", fuelpump_speed, dutyCycle);

  } else {
    analogWrite(FUELPUMP_ENA, 0);
    digitalWrite(FUELPUMP_IN1, LOW);
    digitalWrite(FUELPUMP_IN2, LOW);
  }
}

void webSocketEvent(byte num, WStype_t type, uint8_t * payload, size_t length) {
  switch (type) {
    case WStype_DISCONNECTED:
      Serial.println("Client " + String(num) + " disconnected");
      break;
    
    case WStype_CONNECTED:
      Serial.println("Client " + String(num) + " connected");
      // Send current state to newly connected client
      sendJson("COMPRESSOR_toggle", String(compressor_on));
      sendJson("COMPRESSOR_speed", String(compressor_speed));
      sendJson("FUELPUMP_toggle", String(fuelpump_on));
      sendJson("FUELPUMP_speed", String(fuelpump_speed));
      sendJson("SPARK_toggle", String(spark_on));
      sendJson("BUILTIN_LED_toggle", String(builtin_led_on));
      break;

    case WStype_TEXT:
      {
        StaticJsonDocument<200> doc;
        DeserializationError error = deserializeJson(doc, payload);
        if (error) {
          Serial.print(F("deserializeJson() failed: "));
          Serial.println(error.f_str());
          return;
        }

        const char* msg_type = doc["type"];
        const int msg_value = doc["value"];

        Serial.println("Received: " + String(msg_type) + " = " + String(msg_value));

        // Handle Compressor Messages
        if (String(msg_type) == "COMPRESSOR_toggle") {
          compressor_on = msg_value;
          sendJson("COMPRESSOR_toggle", String(compressor_on));
        } 
        else if (String(msg_type) == "COMPRESSOR_speed") {
          compressor_speed = msg_value;
          sendJson("COMPRESSOR_speed", String(compressor_speed));
          compressor_on = (compressor_speed > 0) ? 1 : 0;
          sendJson("COMPRESSOR_toggle", String(compressor_on));
        }
        
        // Handle Fuel Pump Messages
        else if (String(msg_type) == "FUELPUMP_toggle") {
          fuelpump_on = msg_value;
          sendJson("FUELPUMP_toggle", String(fuelpump_on));
        }
        else if (String(msg_type) == "FUELPUMP_speed") {
          fuelpump_speed = msg_value;
          sendJson("FUELPUMP_speed", String(fuelpump_speed));
          fuelpump_on = (fuelpump_speed > 0) ? 1 : 0;
          sendJson("FUELPUMP_toggle", String(fuelpump_on));
        }

        // Handle Spark Plug Message
        else if (String(msg_type) == "SPARK_toggle") {
          spark_on = msg_value;
          sendJson("SPARK_toggle", String(spark_on));
        }

        // Handle Test LED Message
        else if (String(msg_type) == "BUILTIN_LED_toggle") {
          builtin_led_on = msg_value;
          sendJson("BUILTIN_LED_toggle", String(builtin_led_on));
        }

        // Update all physical outputs
        updateOutputs();
        Serial.println("---");
      }
      break;
  }
}

void setup() {
  Serial.begin(115200);
  Serial.println("\n=== MicroJet Engine Control v1.0 (ESC Integrated) ===");

  // *** ESC SETUP - CRITICAL SECTION ***
  Serial.println("Initializing ESC control...");
  
  // Allocate PWM timers for servo library
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
  
  // Attach ESC (50Hz standard for ESCs)
  compressorESC.setPeriodHertz(50);
  compressorESC.attach(COMPRESSOR_ESC_PIN, 1000, 2000);
  
  // SAFE ARMING: Start with minimum signal
  compressorESC.writeMicroseconds(1000);
  currentCompressorPulse = 1000;
  
  Serial.println("✓ ESC attached to GPIO 18");
  Serial.println("✓ ESC arming sequence: 1000µs signal sent");
  delay(2000); // Wait for ESC to recognize signal
  Serial.println("✓ ESC armed and ready!");

  // Setup other pins
  pinMode(SPARK_PIN, INPUT);  // *** FIXED: Start as INPUT (floating = OFF) ***
  pinMode(BUILTIN_LED, OUTPUT);
  pinMode(FUELPUMP_IN1, OUTPUT);
  pinMode(FUELPUMP_IN2, OUTPUT);
  pinMode(FUELPUMP_ENA, OUTPUT);
  
  // Set initial states
  digitalWrite(BUILTIN_LED, LOW);
  digitalWrite(FUELPUMP_IN1, LOW);
  digitalWrite(FUELPUMP_IN2, LOW);
  analogWrite(FUELPUMP_ENA, 0);
  
  Serial.println("✓ All pins initialized (Spark relay: FLOATING = OFF)");

  // Connect to WiFi
  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n✓ Connected to WiFi!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Start WebServer
  server.on("/", []() {
    server.send_P(200, "text/html", webpage);
  });
  server.begin();
  Serial.println("✓ Web server started");

  // Start WebSocket
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
  Serial.println("✓ WebSocket started on port 81");
  
  Serial.println("\n=== SYSTEM READY ===");
  Serial.println("Access control panel at: http://" + WiFi.localIP().toString());
  Serial.println("========================\n");
}

void loop() {
  server.handleClient();
  webSocket.loop();
  
  // Continuously update outputs (includes spark pulsing logic)
  updateOutputs();
  
  // Keep sending ESC signal to maintain speed
  compressorESC.writeMicroseconds(currentCompressorPulse);
  delay(20);
}
